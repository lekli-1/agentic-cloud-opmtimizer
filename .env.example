PROMETHEUS_URL=http://127.0.0.1:9090
OBSERVE_INTERVAL_SECONDS=30
OBSERVE_WINDOW_SECONDS=600
PROMETHEUS_TIMEOUT_SECONDS=10

# OpenAI is the default
RECOMMENDATION_PROVIDER=openai
DATABASE_PATH=data/optimizer.db
ISSUE_PERSISTENCE_SECONDS=120
CPU_OVERPROVISIONED_RATIO=0.3
CPU_UNDERPROVISIONED_RATIO=0.9
CPU_THROTTLING_THRESHOLD_PERCENT=20
MEMORY_RISK_RATIO=0.85

# Azure mode reports node compute prices, not per-workload dollar savings.
COST_MODE=fixed
AZURE_PRICE_TIMEOUT_SECONDS=10
AZURE_PRICE_CACHE_SECONDS=3600
CPU_PRICE_PER_VCPU_HOUR=0.037
MEMORY_PRICE_PER_GIB_HOUR=0.005

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=none
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=2048

# Execution uses the same provider as recommendations.
ROLLOUT_TIMEOUT_SECONDS=180