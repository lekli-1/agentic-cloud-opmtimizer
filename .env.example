# Copy to .env (gitignored) and fill in locally. Never commit real keys.

# OpenAI (planner agent, M5). Use a small, cheap model during development.
OPENAI_API_KEY=
OPENAI_MODEL=

# Prometheus base URL. Default assumes:
#   kubectl port-forward -n monitoring svc/prometheus-kube-prometheus-prometheus 9090:9090
PROMETHEUS_URL=http://127.0.0.1:9090

# observe | approve | auto
OPTIMIZER_AUTONOMY=approve
