FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.12.21 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src/optimizer src/optimizer
COPY src/dashboard src/dashboard
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.12-slim
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATABASE_PATH=/data/optimizer.db
RUN groupadd --gid 10001 optimizer \
    && useradd --uid 10001 --gid 10001 --no-create-home optimizer \
    && mkdir /data \
    && chown 10001:10001 /data
COPY --from=build /app/.venv /app/.venv
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "optimizer.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
